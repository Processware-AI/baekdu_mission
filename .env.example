# 이 파일을 복사해서 .env 로 저장한 뒤 값을 바꾸세요.

# 접속 포트
PORT=3000
HOST=0.0.0.0

# 세션 암호화 키 — 아무 긴 문자열로 바꾸세요
SESSION_SECRET=여기를-길고-아무도-모르는-문자열로-바꾸세요

# 운영진 계정
ADMIN_ID=admin
ADMIN_PASSWORD=baekdu2026!

# 업로드 최대 용량 (바이트). 기본 400MB
MAX_UPLOAD_BYTES=419430400

# HTTPS로 서비스할 때만 1
COOKIE_SECURE=0

# 데이터 저장 위치 (기본: ./data)
# DATA_DIR=D:/baekdu-data
