# 이 파일을 복사해서 .env 로 저장한 뒤 값을 바꾸세요.

# 접속 포트
PORT=8080
HOST=0.0.0.0

# 세션 암호화 키 — 아무 긴 문자열로 바꾸세요
SESSION_SECRET=여기를-길고-아무도-모르는-문자열로-바꾸세요

# 운영진 계정
ADMIN_ID=admin
ADMIN_PASSWORD=baekdu2026!

# 가이드 계정 (방문지별 단체사진·브이로그 전용, 점수 경쟁에서 제외)
# 계정 이름은 기본 guide01,guide02,guide03,guide04
# GUIDE_IDS=guide01,guide02,guide03,guide04
GUIDE_PASSWORD=여기를-가이드-초기-비밀번호로

# 업로드 최대 용량 (바이트). 기본 400MB — 같은 와이파이로 직접 올릴 때 기준
# 터널을 거쳐 들어오면 아래 TUNNEL_UPLOAD_LIMIT 이 대신 적용됩니다.
MAX_UPLOAD_BYTES=419430400

# 터널(Cloudflare) 경유 시 한도. 무료 플랜이 100MB 근처에서 막습니다.
TUNNEL_UPLOAD_LIMIT=99614720

# HTTPS로 서비스할 때만 1
COOKIE_SECURE=0

# ffmpeg 경로 (영상·사진 썸네일용)
# 보통은 자동으로 찾습니다. 흔치 않은 위치에 설치했을 때만 지정하세요.
# FFMPEG_PATH=/opt/homebrew/bin/ffmpeg

# 데이터 저장 위치 (기본: ./data)
# DATA_DIR=D:/baekdu-data
